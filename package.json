{
	"name": "krimimap",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-sw.mjs",
		"preview": "node scripts/serve-static.mjs --dir build --port 4173 --host 127.0.0.1",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "npm run build && playwright test",
		"lint": "eslint .",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify:fast": "npm run lint && npm run check && npm run test:coverage",
		"verify": "npm run verify:fast && npm run test:e2e",
		"icons": "python3 scripts/generate-icons.py"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.5",
		"workbox-build": "^7.4.1"
	},
	"dependencies": {
		"@mlc-ai/web-llm": "^0.2.86",
		"phaser": "^4.2.1"
	}
}
